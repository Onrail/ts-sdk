{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@onrail-xyz/common",
  "version": "1.0.0",
  "author": "nonergodic",
  "license": "Apache-2.0",
  "description": "Glue layer tying the lower-level packages together: binary layout items for amounts and rates, plus predefined unit kinds",
  "keywords": [
    "amount",
    "unit",
    "currency",
    "kind",
    "rate",
    "binary",
    "layout",
    "serialization"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Onrail/ts-sdk.git",
    "directory": "packages/common"
  },
  "bugs": {
    "url": "https://github.com/Onrail/ts-sdk/issues"
  },
  "homepage": "https://github.com/Onrail/ts-sdk/tree/main/packages/common#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.js",
    "default": "./dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "prepublishOnly": "pnpm test && pnpm build",
    "build": "pnpm clean && tsc",
    "test": "tsc -p tsconfig.test.json && tsc -p tests/loose/tsconfig.json && tsx --test tests/**/*.test.ts",
    "clean": "rm -rf ./dist"
  },
  "peerDependencies": {
    "@onrail-xyz/utils": "^1.0.0",
    "@onrail-xyz/binary-layout": "^1.0.0",
    "@onrail-xyz/amount": "^1.0.0"
  },
  "devDependencies": {
    "@onrail-xyz/utils": "workspace:*",
    "@onrail-xyz/binary-layout": "workspace:*",
    "@onrail-xyz/amount": "workspace:*"
  },
  "engines": {
    "node": ">=25.0.0"
  }
}
