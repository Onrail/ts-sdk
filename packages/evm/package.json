{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@onrail-xyz/evm",
  "version": "1.0.0",
  "author": "nonergodic",
  "license": "Apache-2.0",
  "description": "EVM utilities built on viem: declarative contract specs, ERC20, EIP-2612 permit and EIP-3009 authorization interactions, Multicall3 batched reads, and word-aligned binary layouts",
  "keywords": [
    "ethereum",
    "evm",
    "viem",
    "erc20",
    "permit",
    "eip-2612",
    "eip-3009",
    "eip-712",
    "multicall",
    "abi",
    "layout"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Onrail/ts-sdk.git",
    "directory": "packages/evm"
  },
  "bugs": {
    "url": "https://github.com/Onrail/ts-sdk/issues"
  },
  "homepage": "https://github.com/Onrail/ts-sdk/tree/main/packages/evm#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.js",
    "default": "./dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "prepublishOnly": "pnpm test && pnpm build",
    "build": "pnpm clean && tsc",
    "test": "tsc -p tsconfig.test.json && tsx --test tests/**/*.test.ts",
    "clean": "rm -rf ./dist"
  },
  "peerDependencies": {
    "@onrail-xyz/utils": "^1.0.0",
    "@onrail-xyz/binary-layout": "^1.0.0",
    "@onrail-xyz/amount": "^1.0.0",
    "@onrail-xyz/common": "^1.0.0",
    "@noble/hashes": "^1.8.0 || ^2.0.0",
    "viem": "^2"
  },
  "devDependencies": {
    "@onrail-xyz/utils": "workspace:*",
    "@onrail-xyz/binary-layout": "workspace:*",
    "@onrail-xyz/amount": "workspace:*",
    "@onrail-xyz/common": "workspace:*",
    "@noble/hashes": "^2.2.0",
    "viem": "catalog:"
  },
  "engines": {
    "node": ">=25.0.0"
  }
}
