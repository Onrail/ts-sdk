{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@onrail-xyz/svm",
  "version": "1.0.0",
  "author": "nonergodic",
  "license": "Apache-2.0",
  "description": "Solana/SVM utilities: typed RPC wrappers, PDA/ATA derivation, binary layouts for standard accounts, instruction composition and the ed25519 precompile",
  "keywords": [
    "solana",
    "svm",
    "pda",
    "spl-token",
    "ed25519",
    "layout",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Onrail/ts-sdk.git",
    "directory": "packages/svm"
  },
  "bugs": {
    "url": "https://github.com/Onrail/ts-sdk/issues"
  },
  "homepage": "https://github.com/Onrail/ts-sdk/tree/main/packages/svm#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.js",
    "default": "./dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "prepublishOnly": "pnpm test && pnpm build",
    "build": "pnpm clean && tsc",
    "test": "tsc -p tsconfig.test.json && tsx --test tests/**/*.test.ts",
    "clean": "rm -rf ./dist"
  },
  "peerDependencies": {
    "@onrail-xyz/utils": "^1.0.0",
    "@onrail-xyz/binary-layout": "^1.0.0",
    "@onrail-xyz/amount": "^1.0.0",
    "@onrail-xyz/common": "^1.0.0",
    "@noble/hashes": "^1.8.0 || ^2.0.0",
    "@solana/kit": "^7"
  },
  "devDependencies": {
    "@onrail-xyz/utils": "workspace:*",
    "@onrail-xyz/binary-layout": "workspace:*",
    "@onrail-xyz/amount": "workspace:*",
    "@onrail-xyz/common": "workspace:*",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@solana/kit": "catalog:"
  },
  "engines": {
    "node": ">=25.0.0"
  }
}
